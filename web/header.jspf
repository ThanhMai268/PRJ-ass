

<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<head>
    <meta charset="UTF-8" />
    <title>Footwear - Colorlib</title>
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">

    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css?family=Montserrat:300,400,500,600,700" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css?family=Rokkitt:100,300,400,700" rel="stylesheet">

    <!-- CSS (dùng c:url ?? ?úng context-path) -->
    <link rel="stylesheet" href="<c:url value='/css/animate.css'/>">
    <link rel="stylesheet" href="<c:url value='/css/icomoon.css'/>">
    <link rel="stylesheet" href="<c:url value='/css/ionicons.min.css'/>">
    <link rel="stylesheet" href="<c:url value='/css/bootstrap.min.css'/>">
    <link rel="stylesheet" href="<c:url value='/css/magnific-popup.css'/>">
    <link rel="stylesheet" href="<c:url value='/css/flexslider.css'/>">
    <link rel="stylesheet" href="<c:url value='/css/owl.carousel.min.css'/>">
    <link rel="stylesheet" href="<c:url value='/css/owl.theme.default.min.css'/>">
    <link rel="stylesheet" href="<c:url value='/css/bootstrap-datepicker.css'/>">
    <link rel="stylesheet" href="<c:url value='/fonts/flaticon/font/flaticon.css'/>">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <link rel="stylesheet" href="<c:url value='/css/style.css'/>">
</head>

<body>
    <div class="colorlib-loader"></div>

    <div id="page">
        <nav class="colorlib-nav" role="navigation">
            <div class="top-menu">
                <div class="container">
                    <!-- logo + search -->
                    <div class="row">
                        <div class="col-sm-7 col-md-9">
                            <div id="colorlib-logo"><a href="<c:url value='/Home'/>">ShoesShop</a></div>
                        </div>
                        <div class="col-sm-5 col-md-3">
                            <form action="<c:url value='/Search'/>" class="search-wrap">
                                <div class="form-group">
                                    <input name="name" type="search" class="form-control search" placeholder="Search">
                                    <button class="btn btn-primary submit-search text-center" type="submit">
                                        <i class="icon-search"></i>
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>

                    <!-- menu -->
                    <div class="row">
                        <div class="col-sm-12 text-left menu-1">
                            <ul>
                                <li class="active">
                                    <a href="<c:url value='/Home'/>">Home</a>
                                </li>

                                <li class="has-dropdown">
                                    <a>Category</a>
                                    <ul class="dropdown">
                                        <li>
                                            <a href="Category?cate=Sport+Shoes">
                                                Sport Shoes
                                            </a>
                                        </li>
                                        <li>
                                            <a href="Category?cate=Running+Shoes">
                                                Running Shoes
                                            </a>
                                        </li>
                                        <li>
                                            <a href="Category?cate=Sneakers">
                                                Sneakers
                                            </a>
                                        </li>
                                        <li>
                                            <a href="Category?cate=Sandals">
                                                Sandals
                                            </a>
                                        </li>
                                        <li>
                                            <a href="Category?cate=Training+Shoes">
                                                Training Shoes
                                            </a>
                                        </li>
                                    </ul>
                                </li>

                                <li class="cart">
                                    <c:choose>

                                        <c:when test="${not empty sessionScope.acc}">
                                            <a href="${pageContext.request.contextPath}/Cart">
                                                <i class="icon-shopping-cart"></i> Cart 
                                            </a>
                                        </c:when>


                                        <c:otherwise>
                                            <a href="${pageContext.request.contextPath}/Login?errorCart=1">
                                                <i class="icon-shopping-cart"></i> Cart 
                                            </a>
                                        </c:otherwise>
                                    </c:choose>
                                </li>

                                <c:choose>
                                    <c:when test="${not empty sessionScope.acc}">
                                        <!-- View Orders -->
                                        <li class="user">
                                            <a href="<c:url value='/Order'/>">
                                                <i class="fa fa-receipt"></i> View Orders
                                            </a>
                                        </li>

                                        <!-- Logout -->
                                        <li class="user">
                                            <a href="<c:url value='/Logout'/>">
                                                <i class="fa fa-sign-out-alt"></i> Logout
                                            </a>
                                        </li>
                                    </c:when>

                                    <c:otherwise>
                                        <li class="user">
                                            <a href="login.jsp">
                                                <i class="fa fa-user"></i> Login
                                            </a>
                                        </li>
                                    </c:otherwise>
                                </c:choose>

                            </ul>
                        </div>
                    </div>

                </div>
            </div>

            <!-- sale bar -->
            <div class="sale">
                <div class="container">
                    <div class="row">
                        <div class="col-sm-8 offset-sm-2 text-center">
                            <div class="row">
                                <div class="owl-carousel2">
                                    <div class="item"><div class="col">
                                            <h3><a href="#">25% off (Almost) Everything! Use Code: Summer Sale</a></h3>
                                        </div></div>
                                    <div class="item"><div class="col">
                                            <h3><a href="#">Our biggest sale yet 50% off all summer shoes</a></h3>
                                        </div></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </nav>
